# Supabase (via Vercel integration: vercel integration add supabase)
# Use the Transaction pooler URL (port 6543) for serverless
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Also set by Vercel Supabase integration:
# POSTGRES_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API URL (frontends point here)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Circle Sandbox (https://app-sandbox.circle.com)
CIRCLE_API_KEY=
CIRCLE_ACCOUNT_ID=

# Monad RPC
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
