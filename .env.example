# Database (Neon Postgres — required for Vercel deploy)
# Create free DB at https://neon.tech and paste connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# API URL (frontends point here)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Portal (mocked in demo — real access requires Portal onboarding)
PORTAL_API_KEY=

# Circle (for production mint/onboarding)
CIRCLE_API_KEY=

# Monad RPC (optional override)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
