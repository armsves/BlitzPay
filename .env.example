# Database (Neon Postgres — required for Vercel deploy)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# API URL (frontends point here)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Circle Sandbox (https://app-sandbox.circle.com)
# Get API key from Circle Sandbox dashboard → API Keys
CIRCLE_API_KEY=
# Optional: Circle business account ID for live sandbox payouts
CIRCLE_ACCOUNT_ID=

# Monad RPC (optional override)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
